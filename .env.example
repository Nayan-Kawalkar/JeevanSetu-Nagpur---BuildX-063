# JeevanSetu 360 — all variables are OPTIONAL for the hackathon demo.
# Copy to .env.local. Never commit real keys.

# Enables Claude-based requirement extraction (server-side only). Without it,
# the deterministic keyword extractor is used.
ANTHROPIC_API_KEY=

# Protects POST /api/demo/reset when deployed. Leave empty in local dev.
DEMO_RESET_SECRET=

# Optional: enables Google Maps. Needs a MAPS JAVASCRIPT API key (starts "AIza"),
# NOT an OAuth client ID. Without it the app draws its own offline SVG map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
